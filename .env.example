# -------------------------------
# Client-safe (can be exposed)
# -------------------------------
# If your browser code (Supabase JS client) needs the URL,
# prefer NEXT_PUBLIC_SUPABASE_URL so it’s available on the client.
NEXT_PUBLIC_SUPABASE_URL=<https://YOUR-PROJECT.supabase.co>

# Public anon key (safe for browser; still treat as a credential with RLS on)
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# -------------------------------
# Server-only (NEVER expose to client)
# -------------------------------
# OpenAI API key used by server routes and scripts only
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Service role key — powerful; use ONLY in server code (API routes/scripts)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# If you also reference SUPABASE_URL on the server (non-client code),
# keep it in sync with NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=<https://YOUR-PROJECT.supabase.co>

# Direct Postgres access (only if your scripts connect directly)
POSTGRES_HOST=<db.YOUR-PROJECT.supabase.co>
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR_DB_PASSWORD>

# Embedding model name for ingestion scripts
OPENAI_EMBED_MODEL=text-embedding-3-small
